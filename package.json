{
  "name": "mote",
  "productName": "mote",
  "version": "1.0.12",
  "description": "A Markdown notes app compatible with Obsidian vaults",
  "main": "./out/main/index.js",
  "author": "wenli",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "predev": "node tools/patch-electron-plist.mjs",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps && node tools/patch-electron-plist.mjs",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:mac": "npm run build && electron-builder --mac --dir",
    "build:dmg": "npm run build && electron-builder --mac dmg",
    "build:dmg:all": "npm run build && electron-builder --mac dmg --arm64 --x64 --universal",
    "build:release": "npm run build && electron-builder --mac dmg zip --arm64 --x64 --universal",
    "test": "vitest run && node tools/compare-links.mjs tests/fixtures/vaults/links && node tools/check-docs.mjs",
    "test:e2e": "electron-vite build && playwright test"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@electron-toolkit/utils": "^4.0.0",
    "@lezer/common": "^1.5.5",
    "@lezer/markdown": "^1.8.1",
    "katex": "^0.19.1",
    "lucide": "^1.77.0",
    "lucide-react": "^1.76.0",
    "mermaid": "^12.3.0",
    "mote-sync-protocol": "file:vendor/mote-sync-protocol-0.1.0.tgz",
    "ws": "^8.23.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@playwright/test": "^1.65.1",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.1.1"
  }
}
